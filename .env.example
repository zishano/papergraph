# Copy this file to .env and fill only the services you use.
# Never commit .env or paste real keys into README/config files.

# Google AI Studio: Gemini summaries and 0-100 scores.
GOOGLE_AI_API_KEY=

# Optional OpenAlex key for higher API limits.
OPENALEX_API_KEY=

# Optional: only required for --source scholar --scholar-backend serpapi.
SERPAPI_API_KEY=

# Optional local VPN/proxy HTTP or mixed port.
PAPERGRAPH_PROXY=

# Optional Gemini model override. Keep auto for free-model rotation.
# Supported default candidates in the current implementation:
# gemini-3-flash-preview, gemini-3.6-flash, gemini-3.7-flash, gemini-3.8-flash,
# gemini-3.5-flash-lite, gemini-flash-lite-latest.
# You can also set any generateContent model returned by Google AI Studio.
PAPERGRAPH_GEMINI_MODEL=auto
